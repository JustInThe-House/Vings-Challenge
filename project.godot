[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=80
jolt_physics_3d/simulation/position_steps=10
jolt_physics_3d/simulation/speculative_contact_distance=0.0
jolt_physics_3d/simulation/continuous_cd_movement_threshold=0.0
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.0
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true
jolt_physics_3d/collisions/collision_margin_fraction=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.4506483, 0.4506483, 0.45064825, 1)
